{
  "cli": {
    "version": ">= 18.0.6",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview-51",
      "ios": {
        "resourceClass": "m1-medium"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m1-medium"
      }
    },
    "previewAndroid": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-android"
    },
    "previewIOS": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium",
        "simulator": false
      },
      "channel": "preview-ios"
    }
  },
  "submit": {
    "production": {}
  }
}
