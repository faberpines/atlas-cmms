<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026_03_04_breaker_panel_tables" author="copilot">
        <!-- Sequences must be created before tables that reference them -->
        <createSequence sequenceName="breaker_panel_seq" incrementBy="50" startValue="1"/>
        <createSequence sequenceName="breaker_seq" incrementBy="50" startValue="1"/>

        <createTable tableName="breaker_panel">
            <column name="id" type="bigint" defaultValueSequenceNext="breaker_panel_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="varchar(255)"/>
            <column name="notes" type="text"/>
        </createTable>

        <createTable tableName="breaker">
            <column name="id" type="bigint" defaultValueSequenceNext="breaker_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="circuit_number" type="varchar(50)"/>
            <column name="amperage" type="integer"/>
            <column name="description" type="varchar(500)"/>
            <column name="panel_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="breaker_panel"
                baseColumnNames="company_id"
                referencedTableName="company"
                referencedColumnNames="id"
                onDelete="CASCADE"
                constraintName="fk_breaker_panel_company"/>

        <addForeignKeyConstraint
                baseTableName="breaker"
                baseColumnNames="company_id"
                referencedTableName="company"
                referencedColumnNames="id"
                onDelete="CASCADE"
                constraintName="fk_breaker_company"/>

        <addForeignKeyConstraint
                baseTableName="breaker"
                baseColumnNames="panel_id"
                referencedTableName="breaker_panel"
                referencedColumnNames="id"
                onDelete="CASCADE"
                constraintName="fk_breaker_panel"/>
    </changeSet>

