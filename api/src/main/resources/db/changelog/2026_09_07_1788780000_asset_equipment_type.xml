<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="2026_09_07_asset_equipment_type" author="openai">
        <addColumn tableName="asset">
            <column name="equipment_type" type="varchar(40)" defaultValue="WAREHOUSE_EQUIPMENT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            UPDATE asset
            SET equipment_type = 'FLEET_VEHICLE'
            WHERE id IN (SELECT asset_id FROM vehicle WHERE asset_id IS NOT NULL)
        </sql>
        <rollback>
            <dropColumn tableName="asset" columnName="equipment_type"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
