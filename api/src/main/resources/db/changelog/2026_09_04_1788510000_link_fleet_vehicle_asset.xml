<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026_09_04_link_fleet_vehicle_asset" author="openai">
        <addColumn tableName="vehicle">
            <column name="asset_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="vehicle"
                baseColumnNames="asset_id"
                referencedTableName="asset"
                referencedColumnNames="id"
                constraintName="fk_vehicle_asset"
                onDelete="SET NULL"/>
        <createIndex tableName="vehicle" indexName="idx_vehicle_asset_id">
            <column name="asset_id"/>
        </createIndex>
        <sql>
            UPDATE vehicle v
            SET asset_id = a.id
            FROM asset a
            WHERE v.asset_id IS NULL
              AND v.company_id = a.company_id
              AND v.asset_number IS NOT NULL
              AND v.asset_number &lt;&gt; ''
              AND v.asset_number = a.bar_code;
        </sql>
    </changeSet>

</databaseChangeLog>
